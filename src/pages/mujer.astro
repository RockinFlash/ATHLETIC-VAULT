---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Catalog from "../components/Catalog.astro";
import { byGender } from "../data/products.js";
const products = byGender("mujer");
---
<Base title="Mujer | Athletic Vault" description="Ropa deportiva original para mujer: leggings, bras, tops, shorts y más de Gymshark, lululemon, Alo y Vuori.">
  <TopBar />
  <Header />
  <main>
    <Catalog title="Mujer" kicker="Colección" sub="Activewear original para ella, importado de USA." products={products} scope="gender:mujer" />
  </main>
  <Footer />
</Base>
