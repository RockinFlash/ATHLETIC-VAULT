---
// Panel Admin · Shell (SPA)
import Logo from "../../components/Logo.astro";
import "../../styles/admin.css";
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · Athletic Vault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body" data-base={base}>
    <div class="admin-shell">
      <!-- Sidebar -->
      <aside class="admin-side">
        <div class="side-logo">
          <span class="mark"><Logo color="#ffffff" height={26} /></span>
          <div>
            <b>Athletic <span>Vault</span></b>
            <span class="tag">Admin</span>
          </div>
        </div>
        <nav class="side-nav" id="sideNav">
          <a class="side-link active" data-view="dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
            Dashboard
          </a>
          <a class="side-link" data-view="products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/><path d="m4 7 8 4 8-4"/><path d="M12 11v10"/></svg>
            Productos
          </a>
          <a class="side-link" data-view="inventory">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18v12H3z"/><path d="M3 11h18"/><path d="M8 7v12"/></svg>
            Inventario
          </a>
          <a class="side-link" data-view="reservations">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Reservas
          </a>
          <a class="side-link" data-view="brands">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
            Marcas
          </a>
          <a class="side-link" data-view="config">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            Configuración
          </a>
        </nav>
        <div class="side-foot">
          <div class="side-user">
            <span class="av" id="userAv">A</span>
            <span id="userName">Admin</span>
          </div>
          <button class="btn-a btn-a--ghost btn-a--sm" id="logoutBtn">Cerrar sesión</button>
        </div>
      </aside>

      <!-- Main -->
      <main class="admin-main">
        <div class="a-notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
          <span><strong>Modo local (demo).</strong> Los cambios se guardan en este navegador. Para producción conecta un backend (Supabase / Firebase / API) en <code>src/lib/db.js</code> y usa autenticación del servidor.</span>
        </div>
        <div id="adminView"></div>
      </main>
    </div>

    <!-- Modal -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal" id="modal"></div>
    </div>

    <!-- Toast -->
    <div class="a-toast" id="aToast"></div>

    <script>
      import "../../scripts/admin.js";
    </script>
  </body>
</html>
