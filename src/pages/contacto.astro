---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InfoPage from "../components/InfoPage.astro";
import { CONFIG } from "../data/products.js";
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent("Hola Athletic Vault 👋, tengo una consulta.")}`;
---
<Base title="Contacto | Athletic Vault" description="Contáctanos por WhatsApp, Instagram o correo. Estamos para ayudarte con tu pedido.">
  <TopBar />
  <Header />
  <main>
    <InfoPage title="Contacto" kicker="Hablemos" sub="¿Dudas sobre tallas, stock o envíos? Escríbenos y te respondemos a la brevedad.">
      <div class="contact-grid">
        <div class="contact-card">
          <div class="row">
            <div class="ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2z"/></svg></div>
            <div><strong>WhatsApp</strong><span>Atención de lunes a sábado, 9:00–19:00</span></div>
          </div>
          <div class="row">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/></svg></div>
            <div><strong>Instagram</strong><span>@{CONFIG.instagram}</span></div>
          </div>
          <div class="row">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></div>
            <div><strong>Correo</strong><span>hola@athleticvault.mx</span></div>
          </div>
        </div>
        <div>
          <h2 style="margin-top:0">Escríbenos directo</h2>
          <p>La forma más rápida de atenderte es por WhatsApp. Mándanos tu consulta y te ayudamos con tallas, disponibilidad, envíos y pagos.</p>
          <a class="btn btn--red" href={wa} target="_blank" rel="noopener" style="margin-top:8px">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2z"/></svg>
            Abrir WhatsApp
          </a>
        </div>
      </div>
    </InfoPage>
  </main>
  <Footer />
</Base>
