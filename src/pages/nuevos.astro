---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Catalog from "../components/Catalog.astro";
import { byNew } from "../data/products.js";
const products = byNew();
---
<Base title="Nuevos | Athletic Vault" description="Lo más nuevo en activewear original: las últimas llegadas de nuestras marcas premium.">
  <TopBar />
  <Header />
  <main>
    <Catalog title="Nuevos" kicker="Recién llegados" sub="Las últimas piezas que acabamos de importar de USA." products={products} />
  </main>
  <Footer />
</Base>
