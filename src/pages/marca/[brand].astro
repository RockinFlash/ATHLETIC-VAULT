---
import Base from "../../layouts/Base.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Catalog from "../../components/Catalog.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import { BRANDS, byBrand } from "../../data/products.js";

export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const products = byBrand(brand.slug);
---
<Base
  title={`${brand.name} | Athletic Vault`}
  description={`Ropa deportiva original de ${brand.name} importada de USA. ${products.length} productos disponibles en Athletic Vault.`}
>
  <TopBar />
  <Header />
  <main>
    <section class="brand-hero">
      <div class="wrap">
        <div class={`brand-hero-logo${brand.dark ? " brand-hero-logo--dark" : ""}`}>
          <BrandLogo slug={brand.slug} height={88} dark={brand.dark} />
        </div>
        <div class="kicker">{brand.tag}</div>
        <h1>{brand.name}</h1>
        <p>Productos originales de {brand.name}, importados de Estados Unidos.</p>
      </div>
    </section>
    <Catalog
      title={brand.name}
      kicker={brand.tag}
      sub=""
      products={products}
      showBrandFilter={false}
      scope={`brand:${brand.slug}`}
      hideHero
    />
  </main>
  <Footer />
</Base>
