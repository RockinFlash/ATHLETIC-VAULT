---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Drops from "../components/Drops.astro";
import Catalog from "../components/Catalog.astro";
import { byDrop } from "../data/products.js";
const products = byDrop();
---
<Base
  title="Drops | Athletic Vault"
  description="Drops limitados de activewear original. Ediciones exclusivas con stock reducido. Activa tu alerta y no te pierdas el próximo drop."
>
  <TopBar />
  <Header />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <div class="kicker">Ediciones limitadas</div>
        <h1>Drops</h1>
        <p>Selecciones exclusivas de las piezas más codiciadas. Stock reducido, una sola vez.</p>
      </div>
    </section>
    <Drops />
    <Catalog
      title="Piezas del próximo drop"
      kicker="Limited"
      sub="Novedades y stock limitado. Cuando se agota, no vuelve."
      products={products}
    />
  </main>
  <Footer />
</Base>
