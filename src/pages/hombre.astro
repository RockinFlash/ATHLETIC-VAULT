---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Catalog from "../components/Catalog.astro";
import { byGender } from "../data/products.js";
const products = byGender("hombre");
---
<Base title="Hombre | Athletic Vault" description="Ropa deportiva original para hombre: playeras, shorts, hoodies y más de Gymshark, Under Armour, lululemon y Alo.">
  <TopBar />
  <Header />
  <main>
    <Catalog title="Hombre" kicker="Colección" sub="Activewear original para él, importado de USA." products={products} scope="gender:hombre" />
  </main>
  <Footer />
</Base>
