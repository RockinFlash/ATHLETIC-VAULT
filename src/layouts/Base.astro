---
// Layout base de Athletic Vault con SEO completo
import "../styles/global.css";
import SearchOverlay from "../components/SearchOverlay.astro";
import CartDrawer from "../components/CartDrawer.astro";
import FavDrawer from "../components/FavDrawer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

const {
  title = "Athletic Vault | Premium Activewear USA → México",
  description = "Compra ropa deportiva original de Gymshark, lululemon y otras marcas premium de USA. Athletic Vault importa y comercializa activewear en México.",
  ogImage = "",
}: {
  title?: string;
  description?: string;
  ogImage?: string;
} = Astro.props;

const site = "https://athleticvault.com.mx"; 
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
const favicon = "data:image/svg+xml," + encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 146 100'><rect width='146' height='100' fill='#0a0a0a'/><g fill='#fff'><path fill-rule='evenodd' d='M55 10 L92 90 H74 L66 70 H44 L36 90 H18 Z M55 30 L64 58 H46 Z'/><path d='M78 10 H96 L112 60 L128 10 H146 L118 90 H106 Z'/></g></svg>`
);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={favicon} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Athletic Vault" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@900&display=swap" rel="stylesheet" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ClothingStore",
      "name": "Athletic Vault",
      "description": "Tienda mexicana que importa y comercializa ropa deportiva original de marcas premium de Estados Unidos.",
      "url": site,
      "currenciesAccepted": "MXN",
      "areaServed": "MX",
      "sameAs": ["https://instagram.com/athleticvault.mx"],
    })} />
  </head>
  <body data-base={base}>
    <slot />
    <SearchOverlay />
    <CartDrawer />
    <FavDrawer />
    <WhatsAppFloat />
    <div class="toast" id="toast" role="status" aria-live="polite">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
      <span id="toastMsg">Listo</span>
    </div>
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
