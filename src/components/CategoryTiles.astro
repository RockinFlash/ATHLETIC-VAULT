---
// Tiles de categorías: Mujer, Hombre, Accesorios, Ofertas
// Cada tile filtra el grid al hacer clic (vía data-filter)
const tiles = [
  {
    title: "Mujer",
    sub: "LEGGINGS, TOPS, SHORTS Y MÁS",
    filter: "Mujer",
    bg: `<svg viewBox='0 0 300 230' preserveAspectRatio='xMidYMid slice'><rect width='300' height='230' fill='#2b2b2b'/><g fill='#0d0d0d'><circle cx='150' cy='70' r='26'/><path d='M120 96 h60 v30 c0 8 5 14 5 24 l-6 70 c0 8 -6 12 -14 12 h-12 c-8 0 -12 -4 -12 -12 l-4 -50 h-4 l-4 50 c0 8 -4 12 -12 12 h-12 c-8 0 -14 -4 -14 -12 l-6 -70 c0 -10 5 -16 5 -24 z'/></g></svg>`,
  },
  {
    title: "Hombre",
    sub: "PLAYERAS, SHORTS, HOODIES Y MÁS",
    filter: "Hombre",
    bg: `<svg viewBox='0 0 300 230' preserveAspectRatio='xMidYMid slice'><rect width='300' height='230' fill='#333'/><g fill='#0d0d0d'><circle cx='150' cy='66' r='28'/><path d='M112 96 l30 -14 c8 8 30 8 38 0 l30 14 l22 26 l-20 18 l-8 -8 v90 c0 8 -6 14 -14 14 h-60 c-8 0 -14 -6 -14 -14 v-90 l-8 8 l-20 -18 z'/></g></svg>`,
  },
  {
    title: "Accesorios",
    sub: "BOLSAS, GORRAS, BOTELLAS Y MÁS",
    filter: "Accesorios",
    bg: `<svg viewBox='0 0 300 230' preserveAspectRatio='xMidYMid slice'><rect width='300' height='230' fill='#3a3a3a'/><g fill='#0d0d0d'><path d='M90 90 h120 l-10 100 c-1 8 -8 14 -16 14 h-68 c-8 0 -15 -6 -16 -14 z'/><path d='M115 90 c0 -20 12 -30 35 -30 c23 0 35 10 35 30' fill='none' stroke='#0d0d0d' stroke-width='9'/></g></svg>`,
  },
  {
    title: "Ofertas",
    sub: "HASTA 50% OFF",
    filter: "Ofertas",
    offer: true,
    bg: `<svg viewBox='0 0 300 230' preserveAspectRatio='xMidYMid slice'><rect width='300' height='230' fill='#e11d2e'/><g fill='rgba(255,255,255,.15)'><circle cx='230' cy='60' r='50'/><circle cx='60' cy='180' r='40'/></g></svg>`,
  },
];
---
<div class="wrap">
  <div class="tiles">
    {tiles.map((t) => (
      <div class={`tile ${t.offer ? "offer" : ""}`} data-filter={t.filter} role="button" tabindex="0">
        <div class="tile-bg" set:html={t.bg}></div>
        <span class="tile-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
        <h3>{t.title}</h3>
        <p>{t.sub}</p>
      </div>
    ))}
  </div>
</div>
