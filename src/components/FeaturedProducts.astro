---
// Productos destacados: tabs + grid filtrable
// Renderiza todas las prendas con data-attrs; el JS filtra en vivo.
import { PRODUCTS, silhouette, svgURI } from "../data/products.js";

const money = (n) =>
  new Intl.NumberFormat("es-MX", { style: "currency", currency: "MXN", maximumFractionDigits: 0 }).format(n);

const ACCESSORY = ["Bolsa", "Botella", "Gorra"];
const isAccessory = (c) => ACCESSORY.includes(c);

// Prepara cada producto con su imagen y flags de filtro
const items = PRODUCTS.map((p, i) => ({
  ...p,
  id: i,
  img: svgURI(silhouette(p.category, p.colors[0].hex)),
  accessory: isAccessory(p.category),
  offer: !!p.badge,
}));
---
<section class="wrap" id="destacados">
  <div class="sec-head">
    <h2>Productos destacados</h2>
    <div class="tabs" id="tabs">
      <button class="tab active" data-tab="Todos">Todos</button>
      <button class="tab" data-tab="Mujer">Mujer</button>
      <button class="tab" data-tab="Hombre">Hombre</button>
      <button class="tab" data-tab="Accesorios">Accesorios</button>
    </div>
  </div>

  <div class="pgrid" id="pgrid">
    {items.map((p) => (
      <article
        class="pcard"
        data-id={p.id}
        data-gender={p.gender}
        data-accessory={p.accessory ? "1" : "0"}
        data-offer={p.offer ? "1" : "0"}
        data-brand={p.brand}
        data-name={p.name.toLowerCase()}
        onclick={`openProduct(${p.id})`}
      >
        <div class="pthumb">
          <img src={p.img} alt={p.name} loading="lazy" />
          {p.badge && (
            <span class="pbadge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/></svg>
              {p.badge}
            </span>
          )}
          <button class="wish" onclick="event.stopPropagation();toggleWish(this)" aria-label="Favorito">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21z"/></svg>
          </button>
        </div>
        <div class="pbody">
          <div class="pname">{p.name}</div>
          <div class="pprice">{money(p.price)}</div>
          <div class="pcolors">
            {p.colors.slice(0, 4).map((c) => (
              <span class="cdot" style={`background:${c.hex}`}></span>
            ))}
            {p.colors.length > 4 && <span class="more">+{p.colors.length - 4}</span>}
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="empty hidden" id="emptyState">
    <div class="big">🔍</div>
    <h3>Sin resultados</h3>
    <p>No encontramos prendas con esos filtros.</p>
  </div>
</section>
