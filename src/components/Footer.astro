---
// Footer: 4 columnas + barra inferior
import Logo from "./Logo.astro";
import { BRANDS } from "../data/products.js";
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href={base + "/"}>
          <Logo color="#ffffff" height={30} />
          <span class="logo-text">ATHLETIC VAULT</span>
        </a>
        <p>
          Tienda mexicana que importa y comercializa ropa deportiva original de marcas
          premium de Estados Unidos. Premium activewear, de USA a México.
        </p>
        <div class="foot-socials">
          <a href="https://instagram.com/athleticvault.mx" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://tiktok.com/@athleticvault.mx" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.3 1.9 4 4 4.3v3c-1.5 0-2.9-.5-4-1.3v6.5c0 3.3-2.7 6-6 6s-6-2.7-6-6 2.7-6 6-6c.3 0 .7 0 1 .1v3.1c-.3-.1-.7-.2-1-.2a3 3 0 1 0 3 3V3h3z"/></svg>
          </a>
          <a href="https://facebook.com/athleticvault.mx" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg>
          </a>
        </div>
      </div>

      <div class="foot-col">
        <h4>Tienda</h4>
        <a href={base + "/mujer"}>Mujer</a>
        <a href={base + "/hombre"}>Hombre</a>
        <a href={base + "/accesorios"}>Accesorios</a>
        <a href={base + "/nuevos"}>Nuevos</a>
        <a href={base + "/ofertas"}>Ofertas</a>
      </div>

      <div class="foot-col">
        <h4>Marcas</h4>
        {BRANDS.slice(0, 5).map((b) => (
          <a href={base + `/marca/${b.slug}`}>{b.name}</a>
        ))}
        <a href={base + "/marcas"}>Ver todas</a>
      </div>

      <div class="foot-col">
        <h4>Ayuda</h4>
        <a href={base + "/autenticidad"}>Autenticidad</a>
        <a href={base + "/envios"}>Envíos</a>
        <a href={base + "/cambios"}>Cambios y devoluciones</a>
        <a href={base + "/guia-tallas"}>Guía de tallas</a>
        <a href={base + "/faq"}>Preguntas frecuentes</a>
        <a href={base + "/contacto"}>Contacto</a>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} Athletic Vault. Todos los derechos reservados.</span>
      <span class="flag">🇺🇸 FROM USA → 🇲🇽 TO MX</span>
      <span>
        <a href={base + "/terminos"} style="margin-right:16px">Términos</a>
        <a href={base + "/privacidad"}>Privacidad</a>
      </span>
    </div>
  </div>
</footer>
