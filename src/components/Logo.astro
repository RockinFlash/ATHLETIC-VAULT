---
// Isotipo AV de Athletic Vault (monograma A + V) — imagen PNG oficial.
// color: "negro" (fondo claro) o "blanco" (fondo oscuro, se invierte).
// height: alto en px.
const { color = "#0a0a0a", height = 30 }: { color?: string; height?: number } = Astro.props;
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
const light = color === "#ffffff" || color === "white" || color === "#fff";
---
<span class={`mark${light ? " mark--light" : ""}`} aria-hidden="true">
  <img
    src={`${base}/img/logo.png`}
    alt="Athletic Vault"
    style={`height:${height}px;width:auto;display:block`}
    loading="eager"
  />
</span>
