---
// Header sticky: logo + navegación (con mega-menu) + acciones
import Logo from "./Logo.astro";
import { BRANDS } from "../data/products.js";

const path = Astro.url.pathname;
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
const isActive = (p) => (p === "/" ? path === "/" : path.startsWith(p));
const brandLinks = BRANDS.slice(0, 6);
---
<header class="header" id="header">
  <div class="wrap">
    <a class="logo" href={base + "/"} aria-label="Athletic Vault — Inicio">
      <Logo color="#0a0a0a" height={30} />
      <span class="logo-text">ATHLETIC VAULT</span>
    </a>

    <nav class="nav" id="nav" aria-label="Navegación principal">
      <a href={base + "/"} class={isActive("/") ? "active" : ""}>Inicio</a>

      <div class="nav-item">
        <a href={base + "/marcas"} class={isActive("/marcas") ? "active" : ""}>
          Marcas
          <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="mega">
          <div>
            <h5>Marcas disponibles</h5>
            {brandLinks.map((b) => (
              <a href={base + `/marca/${b.slug}`}>{b.name}</a>
            ))}
          </div>
          <div>
            <h5>Comprar</h5>
            <a href={base + "/mujer"}>Mujer</a>
            <a href={base + "/hombre"}>Hombre</a>
            <a href={base + "/accesorios"}>Accesorios</a>
            <a href={base + "/ofertas"}>Ofertas</a>
          </div>
          <a class="mega-feat" href={base + "/drops"}>
            <span>
              <strong>THE NEXT DROP</strong>
              <span>Black Friday 2026 · Edición limitada</span>
            </span>
            <span class="btn btn--red btn--sm">Ver drop</span>
          </a>
        </div>
      </div>

      <a href={base + "/mujer"} class={isActive("/mujer") ? "active" : ""}>Mujer</a>
      <a href={base + "/hombre"} class={isActive("/hombre") ? "active" : ""}>Hombre</a>
      <a href={base + "/accesorios"} class={isActive("/accesorios") ? "active" : ""}>Accesorios</a>
      <a href={base + "/nuevos"} class={isActive("/nuevos") ? "active" : ""}>Nuevos</a>
      <a href={base + "/ofertas"} class={isActive("/ofertas") ? "active" : ""}>Ofertas</a>
      <a href={base + "/drops"} class={isActive("/drops") ? "active" : ""}>Drops</a>
    </nav>

    <div class="head-actions">
      <button class="icon-btn" id="searchToggle" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button class="icon-btn" aria-label="Cuenta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
      </button>
      <button class="icon-btn" id="favOpen" aria-label="Favoritos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="badge-count hidden" id="favCount">0</span>
      </button>
      <button class="icon-btn" id="bagBtn" aria-label="Carrito">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="badge-count hidden" id="bagCount">0</span>
      </button>
      <button class="icon-btn burger" id="burgerBtn" aria-label="Menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
