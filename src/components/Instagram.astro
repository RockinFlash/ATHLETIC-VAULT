---
// Instagram: grid de contenido + CTA
import { silhouette, svgURI } from "../data/products.js";
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
const ig = [
  { c: "Legging", col: "#3a3a3a" },
  { c: "Bra deportivo", col: "#4a4a4a" },
  { c: "Hoodie", col: "#2f2f2f" },
  { c: "Camiseta", col: "#555" },
  { c: "Short", col: "#383838" },
  { c: "Chaqueta", col: "#444" },
];
---
<section class="section section--tight">
  <div class="wrap">
    <div class="sec-head sec-head--center reveal">
      <span class="sec-kicker">Síguenos</span>
      <h2 class="sec-title">@athleticvault.mx</h2>
      <p class="sec-sub">Drops, behind the scenes y novedades. Síguenos en Instagram.</p>
    </div>
    <div class="ig-grid reveal" data-delay="1">
      {ig.map((it) => (
        <a class="ig-tile" href="https://instagram.com/athleticvault.mx" target="_blank" rel="noopener" aria-label="Instagram Athletic Vault">
          <img src={svgURI(silhouette(it.c, it.col))} alt="Producto Athletic Vault" loading="lazy" />
          <span class="ig-ico">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </span>
        </a>
      ))}
    </div>
    <div class="ig-cta reveal" data-delay="2">
      <a href="https://instagram.com/athleticvault.mx" target="_blank" rel="noopener" class="btn btn--outline">
        Seguir en Instagram
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </div>
</section>
