---
// Modal de producto + drawer de mis apartados + toast
// La estructura es estática; el JS (main.js) la llena y controla.
---
<!-- MODAL PRODUCTO -->
<div class="overlay" id="overlay">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="mimg" id="modalImg">
      <button class="mclose" id="modalClose" aria-label="Cerrar">×</button>
    </div>
    <div class="minfo" id="modalInfo"><!-- JS --></div>
  </div>
</div>

<!-- DRAWER MIS APARTADOS -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<aside class="drawer" id="drawer" aria-label="Mis apartados">
  <div class="drawer-head">
    <h3>Mis apartados 🛍️</h3>
    <button class="icon-btn" id="drawerClose" aria-label="Cerrar">×</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
</aside>

<!-- TOAST -->
<div class="toast" id="toast"></div>
