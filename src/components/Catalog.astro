---
// Catálogo reutilizable: hero + filtros funcionales + grid + orden
import ProductCard from "./ProductCard.astro";
import { BRANDS } from "../data/products.js";

const {
  title,
  kicker = "Colección",
  sub = "",
  products,
  showBrandFilter = true,
  scope = "",
}: {
  title: string;
  kicker?: string;
  sub?: string;
  products: any[];
  showBrandFilter?: boolean;
  scope?: string;
} = Astro.props;

const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";

// Facetas derivadas de los productos mostrados
const cats = [...new Set(products.map((p) => p.category))];
const sizes = [...new Set(products.flatMap((p) => p.sizes))].sort();
const colors = [...new Set(products.flatMap((p) => p.colors.map((c) => c.name)))];
const brands = showBrandFilter
  ? BRANDS.filter((b) => products.some((p) => p.brandSlug === b.slug))
  : [];
const prices = products.map((p) => p.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const fmt = (n) => "$" + n.toLocaleString("es-MX");
---
<section class="page-hero">
  <div class="wrap">
    <div class="kicker">{kicker}</div>
    <h1>{title}</h1>
    {sub && <p>{sub}</p>}
  </div>
</section>

<section class="section section--tight" id="catalog" data-scope={scope} data-show-brand={showBrandFilter ? "1" : "0"}>
  <div class="wrap" style="display:grid;grid-template-columns:260px 1fr;gap:36px;align-items:start">
    <!-- Filtros -->
    <aside class="filters" id="filters" aria-label="Filtros">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <strong style="font-size:15px">Filtros</strong>
        <button class="btn btn--sm btn--outline hidden" id="clearFilters" style="padding:6px 12px;font-size:11px">Limpiar</button>
      </div>

      {showBrandFilter && brands.length > 0 && (
        <div class="fgroup" data-facet="brand">
          <h4 class="flabel">Marca</h4>
          {brands.map((b) => (
            <label class="fopt">
              <input type="checkbox" value={b.slug} />
              <span>{b.name}</span>
            </label>
          ))}
        </div>
      )}

      <div class="fgroup" data-facet="category">
        <h4 class="flabel">Categoría</h4>
        {cats.map((c) => (
          <label class="fopt">
            <input type="checkbox" value={c} />
            <span>{c}</span>
          </label>
        ))}
      </div>

      <div class="fgroup" data-facet="size">
        <h4 class="flabel">Talla</h4>
        <div class="fchips">
          {sizes.map((s) => (
            <button class="fchip" data-size={s}>{s}</button>
          ))}
        </div>
      </div>

      <div class="fgroup" data-facet="color">
        <h4 class="flabel">Color</h4>
        <div class="fchips">
          {colors.map((c) => (
            <button class="fchip" data-color={c}>{c}</button>
          ))}
        </div>
      </div>

      <div class="fgroup" data-facet="price">
        <h4 class="flabel">Precio (MXN)</h4>
        <div style="display:flex;gap:10px;align-items:center">
          <input type="number" id="priceMin" min={0} max={maxPrice} value={minPrice} style="width:100%" aria-label="Precio mínimo" />
          <span style="color:var(--muted)">—</span>
          <input type="number" id="priceMax" min={0} max={maxPrice} value={maxPrice} style="width:100%" aria-label="Precio máximo" />
        </div>
      </div>

      <div class="fgroup" data-facet="availability">
        <h4 class="flabel">Disponibilidad</h4>
        <label class="fopt">
          <input type="checkbox" value="in" />
          <span>En existencia</span>
        </label>
        <label class="fopt">
          <input type="checkbox" value="low" />
          <span>Pocas unidades</span>
        </label>
      </div>
    </aside>

    <!-- Grid -->
    <div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap">
        <span id="resultCount" style="font-size:14px;color:var(--muted)">{products.length} productos</span>
        <div style="display:flex;align-items:center;gap:10px">
          <button class="btn btn--sm btn--outline hidden" id="filterToggle" style="padding:9px 14px;font-size:12px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            Filtros
          </button>
          <select id="sortSelect" aria-label="Ordenar por" style="font-family:inherit;font-size:13px;padding:9px 12px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;color:var(--ink)">
            <option value="featured">Destacados</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="discount">Mayor descuento</option>
            <option value="name">Nombre A–Z</option>
          </select>
        </div>
      </div>

      <div class="pgrid" id="catalogGrid">
        {products.map((p, i) => <ProductCard product={p} style={`animation-delay:${Math.min(i * 45, 450)}ms`} />)}
      </div>
      <div class="empty hidden" id="catalogEmpty">
        <div class="big">🔍</div>
        <h3>Sin resultados</h3>
        <p>Prueba ajustando los filtros.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .filters{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:22px;position:sticky;top:calc(var(--header-h) + 20px)}
  .fgroup{padding:16px 0;border-bottom:1px solid var(--line)}
  .fgroup:last-child{border:none;padding-bottom:0}
  .flabel{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
  .fopt{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:14px;cursor:pointer;color:var(--ink)}
  .fopt input{width:16px;height:16px;accent-color:var(--red);cursor:pointer}
  .fchips{display:flex;gap:8px;flex-wrap:wrap}
  .fchip{padding:7px 13px;border:1px solid var(--line);border-radius:100px;font-size:12.5px;font-weight:500;transition:all .2s;background:#fff}
  .fchip:hover{border-color:var(--black)}
  .fchip.active{background:var(--black);color:#fff;border-color:var(--black)}
  #priceMin,#priceMax{font-family:inherit;font-size:13px;padding:9px 10px;border:1px solid var(--line);border-radius:var(--radius);color:var(--ink)}
  #priceMin:focus,#priceMax:focus{outline:none;border-color:var(--red)}
  @media (max-width:900px){
    #catalog .wrap{grid-template-columns:1fr !important}
    .filters{position:fixed;top:0;left:0;bottom:0;width:min(320px,85vw);z-index:130;border-radius:0;transform:translateX(-100%);transition:transform .4s var(--ease-out);overflow-y:auto;box-shadow:var(--shadow-lg)}
    .filters.open{transform:translateX(0)}
    #filterToggle{display:inline-flex !important}
  }
</style>
