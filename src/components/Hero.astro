---
// Hero principal: título grande, subtítulo, CTA y badges de confianza
---
<section class="hero">
  <div class="hero-figure" aria-hidden="true">
    <svg viewBox="0 0 600 520" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3a3a3a"/><stop offset="1" stop-color="#0c0c0c"/>
        </linearGradient>
      </defs>
      <rect width="600" height="520" fill="url(#hg)"/>
      <!-- silueta mujer (bra + legging) -->
      <g fill="#000" opacity="0.9">
        <circle cx="330" cy="120" r="34"/>
        <path d="M300 150 h60 v40 c0 10 6 18 6 30 l-8 150 c0 10 -8 16 -18 16 h-18 c-10 0 -16 -6 -16 -16 l-6 -120 h-6 l-6 120 c0 10 -6 16 -16 16 h-18 c-10 0 -18 -6 -18 -16 l-8 -150 c0 -12 6 -20 6 -30 z"/>
        <path d="M300 150 c0 -12 12 -20 30 -20 s30 8 30 20 v14 c0 26 -16 44 -30 44 s-30 -18 -30 -44 z" fill="#111"/>
      </g>
      <!-- silueta hombre (tee) -->
      <g fill="#000" opacity="0.85">
        <circle cx="470" cy="110" r="36"/>
        <path d="M430 150 l34 -16 c8 8 34 8 42 0 l34 16 l24 30 l-22 20 l-8 -8 v150 c0 10 -8 18 -18 18 h-76 c-10 0 -18 -8 -18 -18 v-150 l-8 8 l-22 -20 z"/>
      </g>
    </svg>
  </div>

  <div class="wrap">
    <div class="hero-copy">
      <div class="hero-kicker">DISCIPLINA SIN LÍMITES</div>
      <h1 class="hero-title">LuluShark</h1>
      <p class="hero-sub">Lo mejor de dos mundos. Gymshark, Lululemon. Ahora en México.</p>
      <a href="#destacados" class="btn-red">VER COLECCIÓN
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <div class="hero-trust">
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Envíos a todo México
        </span>
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
          Productos 100% originales
        </span>
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          Pagos seguros
        </span>
      </div>
    </div>
  </div>

  <div class="hero-side">SAME PEOPLE · HIGHER STANDARDS</div>
</section>
