---
// Hero principal: identidad premium, CTAs e indicadores de confianza
const base = Astro.site ? Astro.site.pathname.replace(/\/+$/, "") : "";
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src={`${base}/img/banner.png`} alt="" loading="eager" fetchpriority="high" />
  </div>

  <div class="wrap">
    <div class="hero-copy">
      <div class="hero-kicker reveal in"><span class="dot"></span> Premium Activewear</div>
      <h1 class="hero-title">
        <span style="display:block;animation:heroUp .8s var(--ease-out) both">Athletic</span>
        <span class="accent" style="display:block;animation:heroUp .8s var(--ease-out) .12s both">Vault</span>
      </h1>
      <p class="hero-sub" style="animation:heroUp .8s var(--ease-out) .24s both">
        Las mejores marcas deportivas.<br/>De USA a México.
      </p>
      <div class="hero-cta" style="animation:heroUp .8s var(--ease-out) .36s both">
        <a href={base + "/#vault"} class="btn btn--red">
          Explorar colección
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={base + "/marcas"} class="btn btn--ghost-light">Ver marcas</a>
      </div>
      <div class="hero-trust" style="animation:heroUp .8s var(--ease-out) .48s both">
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
          Productos originales
        </span>
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M12 2c3 3 3 17 0 20M12 2c-3 3-3 17 0 20"/><circle cx="12" cy="12" r="10"/></svg>
          Importados de USA
        </span>
        <span class="trust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Envíos a todo México
        </span>
      </div>
    </div>
  </div>

  <div class="hero-side">PREMIUM ACTIVEWEAR · FROM USA TO MX</div>
</section>

<style>
  @keyframes heroUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
</style>
