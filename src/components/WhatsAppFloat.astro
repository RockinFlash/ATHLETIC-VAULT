---
// Botón flotante de WhatsApp
import { CONFIG } from "../data/products.js";
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent("Hola Athletic Vault 👋, quiero información sobre sus productos.")}`;
---
